# =============================================================================
# GeoSI v4 — Environment Variables
# =============================================================================
# Copy this file to .env and fill in ALL values before running the server.
# NEVER commit .env to version control.
#
# Rules enforced by the application (Phase 1 G3 fix):
#   - In GEOSI_ENV=production: DATABASE_URL is REQUIRED — server refuses to
#     start without it. There is NO fallback default credential.
#   - In GEOSI_ENV=development: DATABASE_URL is optional (PostGIS features
#     will be disabled, a warning is logged, no silent fallback).
# =============================================================================

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------
# "development" | "production"
# production mode enforces: DATABASE_URL required, HTTPS-only CORS origins,
# stricter logging, no debug endpoints.
GEOSI_ENV=development

# ---------------------------------------------------------------------------
# Database (PostGIS)
# ---------------------------------------------------------------------------
# REQUIRED in production. No default. Fail-closed.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# ---------------------------------------------------------------------------
# Vector Store (Qdrant)
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# Leave blank for local unauthenticated Qdrant
QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# LLM Provider API Keys
# Only the providers you intend to use need to be set.
# The engine cascade is: Ollama → Gemini → Claude → rule-based fallback.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama (local, no key required — just set the endpoint)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Gemini model override (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Anthropic model override (default: claude-3-5-sonnet-latest)
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---------------------------------------------------------------------------
# Authentication (Phase 1 — G2 fix)
# ---------------------------------------------------------------------------
# Comma-separated list of valid API keys for the REST API.
# Any Bearer <key> in Authorization header must match one of these.
GEOSI_API_KEYS=

# Comma-separated list of admin API keys.
# Admin keys grant access to destructive endpoints (DELETE /layers, POST /admin/policy).
# Admin keys MUST also be listed in GEOSI_API_KEYS.
GEOSI_ADMIN_KEYS=

# JWT secret for token signing (used alongside API keys for stateful sessions)
GEOSI_JWT_SECRET=

# ---------------------------------------------------------------------------
# CORS (Phase 1 — G2 fix)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins. NEVER use "*" with credentials.
# Example: http://localhost:3000,https://app.yourdomain.com
# Leave blank to disable CORS (server-only / same-origin use).
GEOSI_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------------------------------------------------------------------------
# Session Pool (Phase 1)
# ---------------------------------------------------------------------------
# Max concurrent sessions (GeoSI engine instances) per server process.
SESSION_POOL_MAX_SIZE=50
# Seconds of idle time before a session is evicted.
SESSION_POOL_TTL_SECONDS=1800

# ---------------------------------------------------------------------------
# LLM Cascade Timeouts + Circuit Breaker (Phase 1)
# ---------------------------------------------------------------------------
# Total budget in seconds for a full planning request across all providers.
LLM_TOTAL_BUDGET_SECONDS=30
# Per-provider timeout in seconds.
LLM_PROVIDER_TIMEOUT_SECONDS=10
# Number of consecutive failures before a provider's circuit breaker trips.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# Seconds a tripped circuit breaker stays OPEN before moving to HALF_OPEN.
CIRCUIT_BREAKER_RESET_SECONDS=120

# ---------------------------------------------------------------------------
# MCP Server (Phase 4)
# ---------------------------------------------------------------------------
# Token required for all MCP tool calls. No default.
GEOSI_MCP_TOKEN=
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001

# ---------------------------------------------------------------------------
# Observability / OpenTelemetry (Phase 2)
# ---------------------------------------------------------------------------
# OTLP endpoint for exporting traces (e.g. http://localhost:4317 for Jaeger/Grafana)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=geosi-server
# "true" | "false" — disable in development if you don't have an OTel collector
OTEL_ENABLED=false

# ---------------------------------------------------------------------------
# Neo4j (Phase 9)
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---------------------------------------------------------------------------
# QGIS Headless Mode (server / MCP deployments without a running QGIS GUI)
# ---------------------------------------------------------------------------
# Set to "true" to bootstrap QgsApplication headlessly in the server process.
# Required when running geosi_server or geosi_mcp outside the QGIS plugin.
GEOSI_QGIS_HEADLESS=false
# Path to QGIS prefix dir (e.g. /usr on Linux, /Applications/QGIS.app/Contents on macOS)
QGIS_PREFIX_PATH=
